<Window x:Class="GamingAssistant.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GamingAssistant.Desktop"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="250">

            <TextBlock Text="Duración de la repetición"
                   Margin="0,0,0,8"
                   FontSize="16"/>

            <ComboBox x:Name="DurationComboBox"
                  SelectedIndex="0"
                  Margin="0,0,0,15">

                <ComboBoxItem Content="Seleccionar tiempo..."/>
                <ComboBoxItem Content="30 segundos" Tag="30"/>
                <ComboBoxItem Content="1 minuto" Tag="60"/>
                <ComboBoxItem Content="5 minutos" Tag="300"/>
                <ComboBoxItem Content="10 minutos" Tag="600"/>

            </ComboBox>

            <Button
                x:Name="saveReplayButton"
                Content="Guardar repetición"
                Height="40"
                Click="SaveReplayButton_Click"/>

            <Button x:Name="cancelReplayButton"
                Content="Cancelar operación"
                Height="40"
                IsEnabled="False"
                Click="CancelReplayButton_Click"/>

            <Button Content="Probar SAMIRA"
        Click="TestSamira_Click"/>

        </StackPanel>
    </Grid>
</Window>
