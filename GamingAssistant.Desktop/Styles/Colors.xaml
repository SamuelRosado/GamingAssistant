<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- FONDOS -->
    <SolidColorBrush x:Key="WindowBackgroundBrush"
                     Color="#17151F"/>

    <SolidColorBrush x:Key="SidebarBackgroundBrush"
                     Color="#1D1927"/>

    <SolidColorBrush x:Key="PanelBrush"
                     Color="#211E2B"/>

    <SolidColorBrush x:Key="CardBrush"
                     Color="#2B2638"/>

    <!-- COLORES PRINCIPALES -->
    <SolidColorBrush x:Key="AccentBrush"
                     Color="#9870D8"/>

    <SolidColorBrush x:Key="PrimaryButtonBrush"
                     Color="#7651B5"/>

    <SolidColorBrush x:Key="AccentLightBrush"
                     Color="#C4A3FF"/>

    <!-- TEXTOS -->
    <SolidColorBrush x:Key="PrimaryTextBrush"
                     Color="#F4F0FA"/>

    <SolidColorBrush x:Key="MutedBrush"
                     Color="#A69CB5"/>

    <!-- INTERACCIONES -->
    <SolidColorBrush x:Key="HoverBrush"
                     Color="#30283F"/>

    <SolidColorBrush x:Key="SelectedBrush"
                     Color="#45345E"/>

    <!-- BORDES -->
    <SolidColorBrush x:Key="BorderBrush"
                     Color="#393047"/>

</ResourceDictionary>