<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- BOTÓN HAMBURGUESA -->
    <Style x:Key="HamburgerButtonStyle"
       TargetType="Button">

        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="Background"
            Value="{StaticResource HoverBrush}"/>
        <Setter Property="Foreground"
            Value="{StaticResource AccentLightBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">

                    <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="9">

                        <TextBlock Text="☰"
                               FontSize="19"
                               Foreground="{TemplateBinding Foreground}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="{StaticResource SelectedBrush}"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#63458F"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <Style x:Key="CompactConversationsButtonStyle"
       TargetType="Button">

        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Top"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">

                    <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8">

                        <Viewbox Width="22"
                             Height="22"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">

                            <Grid Width="24" Height="24">
                                <Path Data="M21 11.5A8.38 8.38 0 0 1 12.5 20
                                        A8.38 8.38 0 0 1 8 18.7
                                        L3 20L4.3 15
                                        A8.38 8.38 0 0 1 3 10.5
                                        A8.5 8.5 0 0 1 11.5 2
                                        A8.5 8.5 0 0 1 21 10.5Z"
                                  Stroke="{StaticResource AccentLightBrush}"
                                  StrokeThickness="1.8"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"/>
                            </Grid>
                        </Viewbox>
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="{StaticResource HoverBrush}"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="{StaticResource SelectedBrush}"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ELEMENTOS DEL HISTORIAL DE CONVERSACIONES -->
    <Style x:Key="ConversationListItemStyle"
       TargetType="ListBoxItem">

        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment"
            Value="Stretch"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">

                    <Border x:Name="ItemBorder"
                        Background="Transparent"
                        CornerRadius="9"
                        Padding="11">

                        <ContentPresenter
                        HorizontalAlignment="Stretch"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="{StaticResource HoverBrush}"/>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="{StaticResource SelectedBrush}"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PLANTILLA VISUAL DE CADA CONVERSACIÓN -->
    <DataTemplate x:Key="ConversationItemTemplate">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ICONO -->
            <Grid Grid.Column="0"
              Width="20"
              Height="20"
              Margin="0,0,8,0"
              VerticalAlignment="Center">

                <Viewbox Width="17"
                 Height="17"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">

                    <Path Data="M21 11.5A8.38 8.38 0 0 1 12.5 20
                    A8.38 8.38 0 0 1 8 18.7
                    L3 20L4.3 15
                    A8.38 8.38 0 0 1 3 10.5
                    A8.5 8.5 0 0 1 11.5 2
                    A8.5 8.5 0 0 1 21 10.5Z"
                    Stroke="{StaticResource AccentLightBrush}"
                    StrokeThickness="1.8"
                    StrokeLineJoin="Round"
                    Fill="Transparent"/>
                </Viewbox>

            </Grid>

            <!-- TÍTULO -->
            <TextBlock Grid.Column="1"
                   Text="{Binding Title}"
                   TextTrimming="CharacterEllipsis"
                   FontSize="12"
                   Foreground="{StaticResource PrimaryTextBrush}"
                   VerticalAlignment="Center"/>

        </Grid>

    </DataTemplate>

    <!-- LISTA DE CONVERSACIONES -->
    <Style x:Key="ConversationsListBoxStyle"
       TargetType="ListBox">

        <Setter Property="Background"
            Value="Transparent"/>

        <Setter Property="BorderThickness"
            Value="0"/>

        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
            Value="Disabled"/>

        <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
            Value="Auto"/>

        <Setter Property="ItemContainerStyle"
            Value="{StaticResource ConversationListItemStyle}"/>

        <Setter Property="ItemTemplate"
            Value="{StaticResource ConversationItemTemplate}"/>

    </Style>

</ResourceDictionary>