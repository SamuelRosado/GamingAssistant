<UserControl x:Class="GamingAssistant.Desktop.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GamingAssistant.Desktop.Views"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="245">

    <Border Background="{StaticResource SidebarBackgroundBrush}"
            Padding="16">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <Grid Grid.Row="0" Margin="0,8,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="HamburgerButton"
                Grid.Column="0"
                Style="{StaticResource HamburgerButtonStyle}"
                ToolTip="Contraer o expandir menú"
                Click="HamburgerButton_Click"/>

                <StackPanel x:Name="SidebarBrand"
                    Grid.Column="1"
                    VerticalAlignment="Center">

                    <TextBlock Text="SAMIRA"
                       FontSize="23"
                       FontWeight="Bold"
                       Foreground="#C4A3FF"/>
                    <TextBlock Text="GAMING ASSISTANT"
                       FontSize="9"
                       Foreground="#A69CB5"/>
                </StackPanel>


            </Grid>

            <!-- NUEVA CONVERSACIÓN -->
            <Button x:Name="NewConversationButton"
            Grid.Row="1"
            Content="+  Nueva conversación"
            Style="{StaticResource NewConversationButtonStyle}"
            FontWeight="SemiBold"
            Margin="0,0,0,22"
            ToolTip="Crear nueva conversación"/>

            <!-- HISTORIAL -->
            <Grid x:Name="SidebarHistoryPanel"
            Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
               Text="CONVERSACIONES"
               FontSize="11"
               FontWeight="SemiBold"
               Foreground="#A69CB5"
               Margin="8,0,0,14"/>

                <ListBox x:Name="ConversationsListBox"
             Grid.Row="1"
             Style="{StaticResource ConversationsListBoxStyle}"/>

            </Grid>

            <Button x:Name="CompactConversationsButton"
        Grid.Row="2"
        Style="{StaticResource CompactConversationsButtonStyle}"
        Visibility="Collapsed"
        ToolTip="Conversaciones"
        Click="CompactConversationsButton_Click"/>

            <!-- HERRAMIENTAS -->
            <StackPanel Grid.Row="3"
            Margin="0,12,0,12">

                <Border BorderBrush="#393047"
            BorderThickness="0,1,0,0"
            Margin="0,0,0,12"/>

                <Button x:Name="RepeticionesButton" Style="{StaticResource SidebarNavButton}">
                    <Grid x:Name="RepeticionesContent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                       Text="▣"
                       FontSize="18"
                       Foreground="#C4A3FF"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" RenderTransformOrigin="23.205,-5.018"/>

                        <TextBlock x:Name="RepeticionesLabel"
                       Grid.Column="1"
                       Text="Repeticiones"
                       FontSize="14"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <Button x:Name="ConfiguracionButton" Style="{StaticResource SidebarNavButton}">
                    <Grid x:Name="ConfiguracionContent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                    Text="⚙"
                    FontSize="18"
                    Foreground="#C4A3FF"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

                        <TextBlock x:Name="ConfiguracionLabel"
                    Grid.Column="1"
                    Text="Configuración"
                    FontSize="14"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </StackPanel>

            <!-- IDENTIDAD -->
            <Border Grid.Row="4"
        BorderBrush="#393047"
        BorderThickness="0,1,0,0"
        Padding="0,16,0,4">

                <Grid x:Name="SidebarFooterContent"
            HorizontalAlignment="Stretch">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- AVATAR DE SAMIRA -->
                    <Border x:Name="SidebarAvatar"
                Grid.Column="0"
                Background="#7651B5"
                Width="38"
                Height="38"
                CornerRadius="19"
                Margin="0">

                        <TextBlock Text="✦"
                   FontSize="19"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- INFORMACIÓN -->
                    <StackPanel x:Name="SidebarFooterText"
            Grid.Column="1"
            Margin="10,0,0,0"
            VerticalAlignment="Center">

                        <TextBlock Text="SAMIRA AI"
               FontWeight="SemiBold"
               FontSize="13"/>

                        <TextBlock Text="Tu asistente personal"
               FontSize="10"
               Foreground="#A69CB5"/>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>
    </Border>

</UserControl>
