<UserControl x:Class="GamingAssistant.Desktop.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GamingAssistant.Desktop.Views"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1000">

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Border Grid.Row="0"
            Padding="0,0,0,18"
            BorderBrush="#393344"
            BorderThickness="0,0,0,1">

            <Grid>
                <StackPanel>
                    <TextBlock Text="Conversación"
                           FontSize="23"
                           FontWeight="SemiBold"/>

                    <TextBlock Text="Tu asistente personal está lista."
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                    <Ellipse Width="8"
                         Height="8"
                         Fill="#5DD69A"
                         Margin="0,0,8,0"/>

                    <TextBlock Text="En línea"
                           FontSize="12"
                           Foreground="#5DD69A"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONVERSACIÓN -->
        <ScrollViewer x:Name="ChatScrollViewer"
          Grid.Row="1"
          VerticalScrollBarVisibility="Auto"
          Margin="0,20,0,20">

            <ItemsControl x:Name="ChatMessagesControl">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Grid Margin="0,0,0,16">

                            <Border x:Name="MessageBubble"
                            Background="#302A3E"
                            CornerRadius="12"
                            Padding="16"
                            MaxWidth="550"
                            HorizontalAlignment="Left">

                                <StackPanel>

                                    <TextBlock x:Name="SenderName"
                                   Text="SAMIRA"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#C4A3FF"
                                   Margin="0,0,0,8"/>

                                    <TextBox Text="{Binding Content, Mode=OneWay}"
                                     TextWrapping="Wrap"
                                     Background="Transparent"
                                     Foreground="White"
                                     BorderThickness="0"
                                     IsReadOnly="True"
                                     IsReadOnlyCaretVisible="False"
                                     FontSize="14"
                                     Padding="0"
                                     MaxWidth="500"/>

                                </StackPanel>
                            </Border>

                        </Grid>

                        <DataTemplate.Triggers>

                            <DataTrigger Binding="{Binding IsFromSamira}"
                         Value="False">

                                <Setter TargetName="MessageBubble"
                            Property="Background"
                            Value="#7651B5"/>

                                <Setter TargetName="MessageBubble"
                            Property="HorizontalAlignment"
                            Value="Right"/>

                                <Setter TargetName="SenderName"
                            Property="Text"
                            Value="TÚ"/>

                                <Setter TargetName="SenderName"
                            Property="Foreground"
                            Value="#F0DFFF"/>

                            </DataTrigger>

                        </DataTemplate.Triggers>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

        <!-- ESTADO DE SAMIRA -->
        <StackPanel x:Name="ThinkingIndicator"
        Grid.Row="2"
        Orientation="Horizontal"
        Visibility="Collapsed"
        Margin="0,0,0,12">

            <Ellipse Width="8"
             Height="8"
             Fill="#C4A3FF"
             Margin="0,0,10,0"
             VerticalAlignment="Center"/>

            <TextBlock Text="SAMIRA está pensando..."
            Foreground="#C4A3FF"
            FontSize="12"
            FontStyle="Italic"
            VerticalAlignment="Center"/>

        </StackPanel>

        <!-- ESCRITURA -->
        <Border Grid.Row="3"
            Background="#2B2638"
            CornerRadius="12"
            Padding="12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageTextBox"
                     Grid.Column="0"
                     Background="Transparent"
                     Foreground="#F4F0FA"
                     BorderThickness="0"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     AcceptsReturn="False"
                     MinHeight="35"
                     KeyDown="MessageTextBox_KeyDown"/>

                <Button x:Name="SendMessageButton"
                    Grid.Column="1"
                    Content="Enviar"
                    Background="#7651B5"
                    Margin="10,0,0,0"
                    Click="SendMessageButton_Click"/>
            </Grid>
        </Border>

    </Grid>

</UserControl>
